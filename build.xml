<?xml version="1.0" encoding="UTF-8"?>
<project name="The-Coffee-Shop-Management-System" default="war" basedir=".">
    <description>Ant Build Script for The Coffee Shop Management System Java Web Application (Non-Spring)</description>
    
    <property name="src.dir" value="src/java"/>
    <property name="web.dir" value="web"/>
    <property name="build.dir" value="build"/>
    <property name="build.classes.dir" value="${build.dir}/web/WEB-INF/classes"/>
    <property name="build.lib.dir" value="${build.dir}/web/WEB-INF/lib"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="web/WEB-INF/lib"/>
    
    <path id="compile.classpath">
        <fileset dir="${lib.dir}" includes="*.jar" erroronmissingdir="false"/>
    </path>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <echo message="Cleaned compile and build directories."/>
    </target>

    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init">
        <echo message="Compiling Java Source Files for JDK 17..."/>
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false" source="17" target="17">
            <classpath refid="compile.classpath"/>
        </javac>
    </target>

    <target name="war" depends="compile">
        <echo message="Packaging WAR application..."/>
        <!-- Copy web documents (HTML, CSS, JS, etc.) -->
        <copy todir="${build.dir}/web">
            <fileset dir="${web.dir}"/>
        </copy>
        <!-- Package the WAR -->
        <war destfile="${dist.dir}/The-Coffee-Shop-Management-System.war" webxml="${web.dir}/WEB-INF/web.xml">
            <fileset dir="${build.dir}/web"/>
        </war>
        <echo message="WAR Package created successfully at: ${dist.dir}/The-Coffee-Shop-Management-System.war"/>
    </target>

    <!-- Support standard NetBeans lifecycle targets mapped in IDE UI -->
    <target name="run" depends="war" description="Deploy and launch application inside NetBeans">
        <echo message="Deploying and running application with NetBeans deployment tasks..."/>
        <ant antfile="nbproject/ant-deploy.xml" target="-deploy-ant"/>
    </target>

    <target name="debug" depends="run" description="Debug application inside NetBeans"/>

    <target name="profile" depends="run" description="Profile application inside NetBeans"/>

    <!-- Optional import of standard NetBeans compilation backend in case it is generated locally -->
    <import file="nbproject/build-impl.xml" optional="true"/>
</project>
